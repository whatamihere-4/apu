# Copy to .env in this directory before running docker compose.
# Keep common settings at the top.
# Put advanced internal settings at the bottom.

# ---------------------- shared stack settings ---------------------
# Join your existing Caddy stack on this Docker network (no host ports published here).
# In your Caddyfile, reverse_proxy to apu:5000.
MONOLITH_NETWORK=caddy_net
MEDIA_DOWNLOADS_DIR=./downloads
MEDIA_THUMBS_DIR=./thumbs
CACHE_DIR=./cache

# Optional: scripts/scrape_folders.py (paste browser session headers; no Playwright)
ROOT_FOLDER_LINK=
GOFILE_ACCOUNT_TOKEN=
GOFILE_X_WEBSITE_TOKEN=
GOFILE_USER_AGENT=
GOFILE_ACCEPT_LANGUAGE=

# ---------------------------- upload providers ----------------------------
# Enable one or both backends. When both are on, uploads go to GoFile (full file)
# and Filester (byte-split when >10 GB). If Filester cannot split on disk budget,
# GoFile-only proceeds automatically.
GOFILE_ENABLED=1
FILESTER_ENABLED=0
# Legacy shorthand (overrides defaults above when set):
# UPLOAD_PROVIDER=gofile   → GoFile only
# UPLOAD_PROVIDER=filester → Filester only
# UPLOAD_PROVIDER=dual     → both enabled
# UPLOAD_PROVIDER=gofile
GOFILE_API_KEY=
# Pin GoFile upload server after speedtest (short name or full host — both work):
#   docker compose exec apu python scripts/gofile_upload_speedtest.py --include-regional
# GOFILE_PREFERRED_SERVER=upload-na-phx
# Optional: background scan to auto-pick the fastest GoFile upload server.
# If GOFILE_PREFERRED_SERVER is set, the scan is skipped.
# GOFILE_AUTO_SCAN=1
# How big the probe upload is per server (MiB):
# GOFILE_SCAN_MEGABYTES=3.0
# Parallel probes:
# GOFILE_SCAN_WORKERS=3
# How many top results are considered (prints/debug; winner is still best):
# GOFILE_SCAN_TOP=15
# Also test regional proxies from gofile.io/api (slower scan, sometimes faster):
# GOFILE_SCAN_INCLUDE_REGIONAL=0
# Probe timeouts:
# GOFILE_SCAN_CONNECT_TIMEOUT_SEC=10
# GOFILE_SCAN_READ_TIMEOUT_SEC=120
# Re-scan TTL cache (seconds; set 0 to always re-scan):
# GOFILE_SCAN_CACHE_TTL_SEC=86400
# GOFILE_UPLOAD_SERVER_ATTEMPTS=5
# Filester (https://filester.me/api-docs)
FILESTER_API_KEY=
# Optional Filester overrides (sane defaults shown).
# FILESTER_BASE_URL=https://u1.filester.me
# FILESTER_SITE_URL=https://filester.me
# Split files larger than this (bytes) before upload; Filester's hard cap is 10 GB.
# Default matches migradora (~9.5 GiB): 10200547328
# FILESTER_MAX_PART_BYTES=10200547328
# How to split oversized Filester uploads:
#   bytes         — raw byte splice (movie.mp4.part001); fastest, ~source+one-part disk; not playable until merged
#   ffmpeg        — one-pass stream-copy (movie.PART1.mp4); ~2× disk during split; each part plays in-browser
#   ffmpeg_slice  — per-part stream-copy (movie.PART1.mp4); ~source+one-part disk; each part plays in-browser
# SPLITTER_FFMPEG_TIMEOUT_SEC=1800
# SPLITTER_FFPROBE_TIMEOUT_SEC=300
# SPLITTER_EXTRACT_BACKEND=ffmpeg   # ffmpeg (fast seek) | mkvmerge (legacy fifo path)
# MKVMERGE_BIN=mkvmerge
#   optimal       — one-pass ffmpeg when disk allows, else FILESTER_SPLIT_FALLBACK (bytes or ffmpeg_slice)
# FILESTER_SPLIT_MODE=bytes
# When FILESTER_SPLIT_MODE=optimal and one-pass ffmpeg does not fit on disk:
# FILESTER_SPLIT_FALLBACK=bytes
# Studio folder map for GoFile (apu-style {folder_id: name} JSON).
# Lives in cache/gofile-folders.json alongside filester-folders.json.
# GOFILE_FOLDERS_FILE=./cache/gofile-folders.json
# Studio folder map for Filester ({folder_id: name} JSON). Create folders in the
# Filester UI; uploads go into the selected studio folder (split uploads create a subfolder per video).
# FILESTER_FOLDERS_FILE=./cache/filester-folders.json
# Background sync from GET /api/v1/folders (optional):
# FILESTER_FOLDER_SYNC_ENABLED=0
# FILESTER_FOLDER_SYNC_INTERVAL_SEC=3600
# Sync studio folders under the VR container (default on). When off, only account
# root folders are synced (usually just the VR folder itself).
# FILESTER_FOLDER_SYNC_INCLUDE_CHILDREN=1
# VR container folder — studio folders are its direct children in the dropdown.
# FILESTER_ROOT_FOLDER_ID=558b65a42fdad1f6
# FILESTER_ROOT_FOLDER_NAME=VR
#
# Exclude folder ids from filester-folders.json (studio dropdown + autofill map).
# Split-upload subfolders are appended here automatically. You can also blacklist
# container folders (e.g. root "VR") so only leaf studio folders remain selectable.
# FILESTER_FOLDER_BLACKLIST_FILE=./cache/filester-folder-blacklist.json
# Example:
# {
#   "folder_ids": ["VR_ROOT_ID", "abc123splitfolder"],
#   "notes": {
#     "VR_ROOT_ID": "container — studios are nested underneath",
#     "abc123splitfolder": "split upload: MyVideo (auto)"
#   }
# }
# Manual sync: python scripts/sync_filester_folders.py
# Disk safeguards for split uploads (peak = source + one part + headroom).
# MIN_FREE_DISK_GB=5
# DISK_BUDGET_GB=0
# MAX_SOURCE_FILE_GB=0
# MAX_SOURCE_FILE_BYTES=0
# AUTO_SKIP_OVERSIZED=1
STASHDB_API_KEY=
STASHDB_GRAPHQL_URL=https://stashdb.org/graphql
# After a StashDB match on upload, submit fingerprints (submitFingerprint). Set 0 to disable writes.
STASHDB_AUTO_CONTRIBUTE=1
THUMBER_ENABLED=1
# Hasher sidecar (apu → hasher-http). When HASHER_ENABLED=0, OSHASH/MD5/PHASH toggles are ignored.
HASHER_ENABLED=1
HASHER_OSHASH_ENABLED=1
HASHER_MD5_ENABLED=1
HASHER_PHASH_ENABLED=1
# Only spend time on the slow PHASH when neither OSHASH nor MD5 matched on StashDB.
# The upload check already short-circuits OSHASH → MD5 → PHASH; setting this to 1 also
# skips the post-match PHASH follow-up (submitFingerprint) when the match came from OSHASH/MD5.
# HASHER_PHASH_ONLY_ON_MISS=0
# hasher-http /v1/hash_stream: PHASH heartbeat interval (sec); MD5 progress emit spacing (bytes).
# HASHER_PHASHER_HEARTBEAT_SEC=1
# HASHER_MD5_PROGRESS_BYTES=8388608
# If ./thumbs/<stem>_thumbs.png already exists for the video basename, skip ffmpeg/thumber (default off).
THUMBER_USE_CACHED_THUMBS=0
THUMBER_HTTP_STREAM=1
THUMBER_LOG_LIMIT=80
# Restore still-queued jobs from cache/pending_queue.json on startup (queue tools). Set 0 to disable.
RESTORE_QUEUE=1

# ------------------------ runtime defaults ------------------------
STASH_REF=v0.27.2
HASHER_PHASH_TIMEOUT_SEC=1800
THUMBER_HTTP_VERBOSE=1
THUMBER_FFMPEG_TIMEOUT_SEC=300
THUMBER_FFMPEG_TIMEOUT_SLOW_SEC=600
# GIF host for BBCode image uploads and SLR preview GIF encoding: goonbox | pixhost | gifyu
# GIF_HOST=goonbox

# GoonBox (GIF_HOST=goonbox) — browser upload via plugin on /bbcode.
# GOONBOX_BASE_URL=https://goonbox.cr
# GOONBOX_GIF_FPS=12
# GOONBOX_GIF_WIDTH=480
# GOONBOX_GIF_MAX_DURATION=15
# GOONBOX_GIF_MAX_BYTES=26214400
# GOONBOX_GIF_MAX_ANIMATED_PIXELS=50000000
# GOONBOX_GIF_MAX_FRAMES=120
# Optional album slug from the album URL (e.g. ajDeMe for /a/ajDeMe) — scripts/test_goonbox_auth.py only.
# GOONBOX_ALBUM_ID=ajDeMe
# Use [IMG]direct[/IMG] instead of GoonBox wrapped bbcode when pasting from the plugin (default 1).
# GOONBOX_BBCODE_SIMPLE=1

# Gifyu (GIF_HOST=gifyu) — browser upload via Chevereto PUP on /bbcode.
# SLR 300p source is 500×300 @ 24fps × 14s; defaults target max quality under ~25 MB.
# GIFYU_BASE_URL=https://gifyu.com
# GIFYU_GIF_FPS=24
# GIFYU_GIF_WIDTH=560
# GIFYU_GIF_MAX_DURATION=14
# GIFYU_GIF_MAX_BYTES=26214400
# GIFYU_GIF_MAX_ANIMATED_PIXELS=0
# GIFYU_GIF_MAX_FRAMES=0
# GIFYU_GIF_PALETTE_COLORS=256
# GIFYU_GIF_PALETTE_STATS=diff
# GIFYU_GIF_DITHER=sierra2_4a

# PiXhost (GIF_HOST=pixhost) — server-side upload via /bbcode.
# PIXHOST_API_URL=https://api.pixhost.cc
# PIXHOST_GIF_FPS=12
# PIXHOST_GIF_WIDTH=480
# PIXHOST_GIF_MAX_DURATION=10
# PIXHOST_GIF_MAX_BYTES=10485760
# PIXHOST_GIF_MAX_ANIMATED_PIXELS=0
# PIXHOST_GIF_MAX_FRAMES=0
# content_type form field: 0 = SFW, 1 = NSFW (default 1 for this app).
# PIXHOST_CONTENT_TYPE=1
# Optional thumbnail max edge (150-500); default is PiXhost's 200px.
# PIXHOST_MAX_TH_SIZE=420
# Set to 1 to receive a one-time manage_url in upload responses (save it if you need delete/rename).
# PIXHOST_INCLUDE_MANAGE_URL=0

# Optional: max bytes when apu downloads SLR CDN preview MP4 before GIF encode (default 30000000).
# SLR_PREVIEW_MAX_MP4_BYTES=30000000

# Job cards: show basename in download link text instead of full URL (href stays the URL).
# JOB_LINKS_FILENAME_ONLY=0

# Remote OSHASH (/oshash) — optional HTTP timeouts for ranged fetch (defaults 15 / 60 sec)
# OSHASH_REMOTE_CONNECT_TIMEOUT_SEC=15
# OSHASH_REMOTE_READ_TIMEOUT_SEC=60
# Optional: max suffix bytes to Range-fetch when probing MP4 moov for duration beyond head/tail (default 2097152)
# OSHASH_REMOTE_DURATION_PROBE_MAX_BYTES=2097152

# /phash and /remotehash: after a full download for hashing, delete the file under MEDIA_DOWNLOADS_DIR (default 1). Set 0 to keep it for re-hash or draft workflows.
# REMOTE_HASH_DELETE_FILE=1

# Real-Debrid — resolve panel links (real-debrid.com/d/…) to nearest CDN before download.
# Stremio/Torrentio get CDN URLs like den1-4.download.real-debrid.com; the torrents panel
# gives real-debrid.com/d/ID instead. Set your API token to auto-resolve via /unrestrict/link.
# Token: https://real-debrid.com/apitoken
# REAL_DEBRID_API_TOKEN=
# REAL_DEBRID_API_BASE=https://api.real-debrid.com/rest/1.0
# REAL_DEBRID_REMOTE=0
# Pin CDN hostname after resolve (same /d/id/path on every node). Use the full hostname
# from speedtest output — .cloud vs .com matters (e.g. 45.download.real-debrid.cloud).
#   docker compose exec apu python scripts/realdebrid_cdn_speedtest.py
# REAL_DEBRID_PREFERRED_CDN=45.download.real-debrid.cloud
# Optional: background scan to auto-pick the fastest Real-Debrid CDN host.
# If REAL_DEBRID_PREFERRED_CDN is set, the scan is skipped.
# REAL_DEBRID_AUTO_SCAN=1
# Seconds to download per CDN host during the scan:
# REAL_DEBRID_SCAN_SECONDS=6.0
# Parallel probes:
# REAL_DEBRID_SCAN_WORKERS=8
# Optional hosts list (short names ok: nyk7-4, den1-4). Empty uses built-in list:
# REAL_DEBRID_SCAN_HOSTS=
# How many top results are considered (prints/debug; winner is still best):
# REAL_DEBRID_SCAN_TOP=20
# Probe connect timeout (seconds):
# REAL_DEBRID_SCAN_CONNECT_TIMEOUT_SEC=8
# Re-scan TTL cache (seconds; set 0 to always re-scan):
# REAL_DEBRID_SCAN_CACHE_TTL_SEC=86400
# REAL_DEBRID_CONNECT_TIMEOUT_SEC=15
# REAL_DEBRID_READ_TIMEOUT_SEC=60

# Link download (/downloads) — resume on IncompleteRead / connection drops (defaults below).
# DOWNLOAD_CONNECT_TIMEOUT_SEC=30
# DOWNLOAD_READ_TIMEOUT_SEC=900
# DOWNLOAD_RESUME_ATTEMPTS=16
# DOWNLOAD_CHUNK_SIZE=65536

# ------------------ optional resource limits ------------------
# Leave commented/blank to keep current compose defaults.
#
# apu
# MEM_LIMIT=
# CPU_LIMIT=
# PIDS_LIMIT=
#
# hasher-http
# HASHER_MEM_LIMIT=
# HASHER_CPU_LIMIT=
# HASHER_PIDS_LIMIT=
#
# thumber
# THUMBER_MEM_LIMIT=
# THUMBER_CPU_LIMIT=
# THUMBER_PIDS_LIMIT=
#
# thumber-http
# THUMBER_HTTP_PIDS_LIMIT=
#
# splitter-http (these ARE wired in compose; defaults shown)
# SPLITTER_CPU_LIMIT=1.5
# SPLITTER_MEM_LIMIT=1g
# SPLITTER_PIDS_LIMIT=256
# SPLITTER_FFMPEG_TIMEOUT_SEC=7200
# SPLITTER_HTTP_TIMEOUT_SEC=7800

# ---------------- advanced / internal wiring ----------------
# DO NOT EDIT unless you know exactly why.
# These are internal container-to-container endpoints.
HASHER_HTTP_URL=http://hasher-http:8089
THUMBER_HTTP_URL=http://thumber-http:8080
# Splitter sidecar (legacy ffmpeg path; Filester uploads split in-process via byte ranges).
# Leave empty to split in-process inside apu.
# SPLITTER_HTTP_URL=http://splitter-http:8090
# Optional: override path to thumbs generator inside thumber containers (default /usr/local/bin/thumbs).
# THUMBER_THUMBS_SCRIPT=/usr/local/bin/thumbs

# Optional auth for internal POST routes. Keep empty unless enabled in services.
# HASHER_HTTP_TOKEN=
# THUMBER_HTTP_TOKEN=
# SPLITTER_HTTP_TOKEN=
